{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cache-ttl-analyzer",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "cacheanalyzer.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
}
